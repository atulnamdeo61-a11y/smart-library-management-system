# Flask Application Configuration
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=super-secret-key-change-in-production-random-token-here

# Database Configuration (MySQL Recommended)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/smart_library_db

# Fallback SQLite DB (used if DATABASE_URL starts with sqlite:/// or for local testing)
# DATABASE_URL=sqlite:///smart_library.db

# Library Circulation & Fine Rules (Configurable)
DEFAULT_BORROW_DAYS=14
MAX_ACTIVE_LOANS_PER_STUDENT=3
FINE_RATE_PER_DAY=2.00
FINE_GRACE_PERIOD_DAYS=0
CURRENCY_SYMBOL=₹
REQUIRE_LIBRARIAN_APPROVAL=True
